# Neon Database connection URLs
# 1. Pooled connection string (with -pooler) used by the Next.js runtime
DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Direct connection string (without -pooler) used for migrations & schema push
DIRECT_URL="postgresql://neondb_owner:password@ep-xxx.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Credentials (Single User Admin)
AUTH_USERNAME="admin"
AUTH_PASSWORD="change_this_to_a_secure_password"
AUTH_SECRET="please_generate_a_secure_random_string_at_least_32_characters_long"

# Email Notifications (Gmail / SMTP)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_char_google_app_password"
NOTIFICATION_EMAIL_TO="recipient_email@gmail.com"

# Vercel Cron Security
CRON_SECRET="generate_a_secure_random_cron_secret"

